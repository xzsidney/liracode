<%- include('partials/header', { 
  titulo: 'LiraCode • Aprenda a controlar o computador, não apenas usá-lo',
  paginaAtiva: 'inicio'
}) %>

<main class="flex-grow">
  
  <!-- =========================================================================
       SEÇÃO 1: HERO NOBRE E ACOLHEDOR (O PROPÓSITO REGIO & FAMILIAR)
       ========================================================================= -->
  <section class="relative overflow-hidden py-14 lg:py-24 bg-gradient-to-b from-slate-950 via-brand-darkblue to-slate-950 border-b-2 border-brand-gold/30">
    <!-- Aura de fundo heráldica -->
    <div class="absolute inset-0 pointer-events-none flex justify-center items-center">
      <div class="w-[500px] h-[500px] bg-brand-gold/5 rounded-full blur-3xl"></div>
      <div class="w-[350px] h-[350px] bg-brand-blue/10 rounded-full blur-2xl -translate-y-20"></div>
    </div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center space-y-8">
      
      <!-- Brasão Oficial LiraCode com Aura Dourada Nobre -->
      <div class="flex flex-col items-center justify-center">
        <div class="relative group cursor-pointer">
          <div class="absolute -inset-3 bg-gradient-to-r from-brand-red via-brand-gold to-brand-blue rounded-full blur-xl opacity-40 group-hover:opacity-75 transition duration-700 animate-pulse"></div>
          <img 
            src="/images/brasao-liracode.png" 
            alt="Brasão Oficial LiraCode" 
            class="relative w-36 h-36 sm:w-44 sm:h-44 object-contain mx-auto drop-shadow-2xl crest-glow transform transition duration-500 group-hover:scale-105"
          >
        </div>

        <!-- Badge Heráldico de Honra -->
        <div class="mt-4 inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-slate-900/90 border border-brand-gold/60 text-amber-300 text-xs sm:text-sm font-semibold tracking-wider shadow-lg">
          <span class="w-2 h-2 rounded-full bg-brand-gold animate-ping"></span>
          <span class="font-display uppercase tracking-widest">Academia de Tecnologia & Cibersegurança</span>
        </div>
      </div>

      <!-- Título Majestoso em Fonte Cinzel -->
      <div class="max-w-4xl mx-auto space-y-4">
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black font-display tracking-tight text-white leading-tight">
          Aprenda a controlar o computador, <br class="hidden sm:inline">
          <span class="gold-gradient-text">
            não apenas usá-lo.
          </span>
        </h1>

        <!-- Subtítulo Focado na Parceria Familiar -->
        <p class="text-slate-300 text-base sm:text-xl leading-relaxed max-w-3xl mx-auto font-sans">
          Uma formação prática aos sábados em <strong>cibersegurança</strong>, <strong>raciocínio lógico</strong> e <strong>autonomia digital</strong> para os nossos filhos.
        </p>
      </div>

      <!-- Os 2 Botões de Ação Nobres -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-6 pt-3">
        <!-- Botão 1: Dourado Imperial -> Portal da Família -->
        <a 
          href="/pais" 
          class="w-full sm:w-auto px-8 py-4 rounded-2xl font-bold font-sans text-slate-950 bg-gradient-to-r from-amber-400 via-amber-500 to-yellow-500 hover:from-amber-300 hover:to-yellow-400 shadow-xl shadow-amber-500/20 transform hover:-translate-y-1 transition duration-300 flex items-center justify-center gap-3 text-base sm:text-lg border border-amber-300/60"
        >
          <i class="fa-solid fa-people-roof text-xl"></i>
          <span>👨‍👩‍👧‍👦 Portal da Família</span>
        </a>

        <!-- Botão 2: Azul Real Nobre -> Vitrine dos Alunos -->
        <a 
          href="https://aula.liracode.com.br/" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="w-full sm:w-auto px-8 py-4 rounded-2xl font-bold font-sans text-white bg-gradient-to-r from-brand-blue to-blue-800 hover:from-blue-700 hover:to-blue-900 border-2 border-brand-gold/60 shadow-xl shadow-blue-900/30 transform hover:-translate-y-1 transition duration-300 flex items-center justify-center gap-3 text-base sm:text-lg group"
        >
          <i class="fa-solid fa-laptop-code text-xl text-sky-400 group-hover:scale-110 transition-transform"></i>
          <span>💻 Ver os Trabalhos dos Alunos</span>
          <i class="fa-solid fa-arrow-up-right-from-square text-xs text-sky-300 opacity-80"></i>
        </a>
      </div>

      <!-- Selos de Confiança para a Família -->
      <div class="flex flex-wrap items-center justify-center gap-4 sm:gap-8 pt-6 border-t border-slate-800/80 text-xs sm:text-sm text-slate-300 font-sans">
        <div class="flex items-center gap-2">
          <i class="fa-solid fa-shield-halved text-brand-gold"></i>
          <span><strong>5 Talentos</strong> no Esquadrão</span>
        </div>
        <div class="flex items-center gap-2">
          <i class="fa-solid fa-user-lock text-emerald-400"></i>
          <span><strong>Privacy by Design:</strong> Avatares 3D Seguros</span>
        </div>
        <div class="flex items-center gap-2">
          <i class="fa-solid fa-calendar-check text-amber-300"></i>
          <span><strong>Aulas aos Sábados</strong> (90 min)</span>
        </div>
      </div>

    </div>
  </section>


  <!-- =========================================================================
       SEÇÃO 2: O ESQUADRÃO DOS PIONEIROS (SHOWCASE DOS 5 AVATARES 3D)
       ========================================================================= -->
  <section class="py-16 lg:py-24 bg-slate-950 border-b-2 border-brand-gold/20 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      
      <!-- Cabeçalho da Seção -->
      <div class="text-center max-w-3xl mx-auto mb-14 space-y-3">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-brand-gold/10 border border-brand-gold/30 text-brand-gold text-xs font-bold uppercase tracking-widest font-sans">
          <i class="fa-solid fa-crown text-amber-400"></i>
          <span>Turma Oficial Pioneira • 2026</span>
        </div>

        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black font-display text-white">
          👑 Os Pioneiros • O Esquadrão LiraCode
        </h2>

        <p class="text-slate-300 text-sm sm:text-base leading-relaxed font-sans">
          Conheça os jovens talentos da turma através de seus <strong>avatares digitais seguros</strong>. Seguindo os princípios rigorosos de cibersegurança e proteção de dados (<em>Privacy by Design</em>), os estudantes são representados com honra no mundo virtual.
        </p>
      </div>

      <!-- Grid Responsivo dos 5 Estudantes -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6">
        <% estudantes.forEach(function(estudante, index) { %>
          <div class="pioneer-card p-6 flex flex-col justify-between group text-center space-y-4">
            
            <!-- Topo do Card: Número & Badge da Turma -->
            <div class="flex items-center justify-between text-[11px] font-mono text-slate-400 pb-2 border-b border-slate-800/80">
              <span class="text-brand-gold font-bold font-display">#0<%= index + 1 %></span>
              <span class="inline-flex items-center gap-1 text-emerald-400">
                <i class="fa-solid fa-shield text-[10px]"></i> Protegido
              </span>
            </div>

            <!-- Imagem do Avatar 3D com Moldura de Halo Dourado & Hover Suave -->
            <div class="relative py-2 flex items-center justify-center">
              <div class="avatar-halo w-36 h-36 sm:w-32 sm:h-32 lg:w-36 lg:h-36">
                <img 
                  src="<%= estudante.avatarRosto %>" 
                  alt="Avatar 3D de <%= estudante.nome %>" 
                  class="w-full h-full object-contain rounded-full drop-shadow-xl"
                  loading="lazy"
                >
              </div>
            </div>

            <!-- Identificação Régia do Estudante -->
            <div class="space-y-2">
              <h3 class="font-display font-black text-xl text-white group-hover:text-amber-300 transition-colors">
                <%= estudante.nome %>
              </h3>

              <!-- Insígnia de Honra -->
              <div class="inline-block px-3 py-1 rounded-lg bg-brand-blue/30 border border-brand-gold/40 text-[11px] font-bold text-amber-300 font-sans shadow-sm">
                <i class="fa-solid fa-award text-brand-gold mr-1"></i> <%= estudante.badge %>
              </div>

              <!-- Status de Nível -->
              <p class="text-xs text-slate-300 font-sans">
                <%= estudante.statusHonra %>
              </p>
            </div>

            <!-- Badge Lúdico de Hacker Ético -->
            <div class="pt-3 border-t border-slate-800/80">
              <div class="px-2.5 py-1.5 rounded-xl bg-slate-900/90 border border-slate-700 text-[10px] text-slate-400 font-mono flex items-center justify-center gap-1.5">
                <i class="fa-solid fa-user-secret text-brand-gold"></i>
                <span>Codinome em breve</span>
              </div>
            </div>

          </div>
        <% }); %>
      </div>

      <!-- Nota de Cibersegurança & Pais -->
      <div class="mt-10 p-4 rounded-2xl bg-slate-900/80 border border-brand-gold/30 text-center max-w-2xl mx-auto flex items-center justify-center gap-3 text-xs text-slate-300 font-sans">
        <i class="fa-solid fa-lock text-brand-gold text-base"></i>
        <span>
          <strong>Compromisso de Privacidade:</strong> Nenhuma foto real de menor é exposta na internet aberta. A segurança dos nossos filhos é prioridade absoluta desde o primeiro dia.
        </span>
      </div>

    </div>
  </section>


  <!-- =========================================================================
       SEÇÃO 3: OS 3 PILARES DA FORMAÇÃO LIRACODE
       ========================================================================= -->
  <section class="py-16 lg:py-24 bg-gradient-to-b from-slate-950 via-brand-darkblue to-slate-950 border-b-2 border-brand-gold/20 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-14 space-y-3">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-brand-gold/10 border border-brand-gold/30 text-brand-gold text-xs font-bold uppercase tracking-widest font-sans">
          <i class="fa-solid fa-gem text-amber-400"></i>
          <span>Metodologia Nobre</span>
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black font-display text-white">
          Os 3 Pilares da Formação
        </h2>
        <p class="text-slate-300 text-sm sm:text-base leading-relaxed font-sans">
          Muito além de superficialidades: uma base sólida de pensamento lógico, controle sobre as máquinas e parceria com a família.
        </p>
      </div>

      <!-- Grid dos 3 Pilares -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        <!-- PILAR 1: Fortaleza Digital (Cibersegurança) -->
        <div class="noble-card p-8 flex flex-col justify-between group border-brand-gold/40">
          <div class="space-y-5">
            <div class="w-16 h-16 rounded-2xl bg-brand-red/20 border-2 border-brand-red text-red-400 flex items-center justify-center text-3xl group-hover:scale-110 transition-transform shadow-lg">
              <i class="fa-solid fa-shield-halved"></i>
            </div>

            <div class="space-y-1">
              <span class="text-xs font-mono font-bold text-amber-300 uppercase tracking-wider">
                Pilar 01 • Proteção Ativa
              </span>
              <h3 class="text-2xl font-bold font-display text-white group-hover:text-amber-300 transition-colors">
                Fortaleza Digital
              </h3>
            </div>

            <p class="text-sm text-slate-300 leading-relaxed font-sans">
              Anatomia do sistema operacional Windows, desmascaramento de arquivos falsos e extensões ocultas (<code class="text-brand-gold">.png.exe</code>), e criação de uma mente crítica contra fraudes, malwares e pegadinhas da web.
            </p>
          </div>

          <div class="pt-6 border-t border-slate-800 text-xs text-amber-300 font-semibold flex items-center gap-2 font-sans">
            <i class="fa-solid fa-check-circle text-emerald-400"></i>
            <span>Segurança aplicada no dia a dia</span>
          </div>
        </div>

        <!-- PILAR 2: Autonomia & Criação -->
        <div class="noble-card p-8 flex flex-col justify-between group border-brand-gold/60 shadow-xl">
          <div class="space-y-5">
            <div class="w-16 h-16 rounded-2xl bg-brand-gold/20 border-2 border-brand-gold text-brand-gold flex items-center justify-center text-3xl group-hover:scale-110 transition-transform shadow-lg">
              <i class="fa-solid fa-terminal"></i>
            </div>

            <div class="space-y-1">
              <span class="text-xs font-mono font-bold text-amber-300 uppercase tracking-wider">
                Pilar 02 • Poder de Execução
              </span>
              <h3 class="text-2xl font-bold font-display text-white group-hover:text-amber-300 transition-colors">
                Autonomia & Criação
              </h3>
            </div>

            <p class="text-sm text-slate-300 leading-relaxed font-sans">
              Sair do papel de mero consumidor passivo de aplicativos de celular para se tornar um criador. Dominando o terminal de comando, a lógica de programação com Node.js e a construção de páginas web autorais.
            </p>
          </div>

          <div class="pt-6 border-t border-slate-800 text-xs text-amber-300 font-semibold flex items-center gap-2 font-sans">
            <i class="fa-solid fa-check-circle text-emerald-400"></i>
            <span>Do terminal preto à Web real</span>
          </div>
        </div>

        <!-- PILAR 3: Parceria com a Família -->
        <div class="noble-card p-8 flex flex-col justify-between group border-brand-gold/40">
          <div class="space-y-5">
            <div class="w-16 h-16 rounded-2xl bg-brand-blue/30 border-2 border-blue-500 text-sky-400 flex items-center justify-center text-3xl group-hover:scale-110 transition-transform shadow-lg">
              <i class="fa-solid fa-handshake-angle"></i>
            </div>

            <div class="space-y-1">
              <span class="text-xs font-mono font-bold text-amber-300 uppercase tracking-wider">
                Pilar 03 • Apoio Familiar
              </span>
              <h3 class="text-2xl font-bold font-display text-white group-hover:text-amber-300 transition-colors">
                Parceria com a Família
              </h3>
            </div>

            <p class="text-sm text-slate-300 leading-relaxed font-sans">
              Transparência semanal e linguagem humana para que pais e mães acompanhem de perto a evolução dos filhos, com sugestões de conversas estimulantes para o almoço de domingo e alinhamento pedagógico contínuo.
            </p>
          </div>

          <div class="pt-6 border-t border-slate-800 text-xs text-amber-300 font-semibold flex items-center gap-2 font-sans">
            <i class="fa-solid fa-check-circle text-emerald-400"></i>
            <span>Orgulho e proximidade em família</span>
          </div>
        </div>

      </div>

    </div>
  </section>


  <!-- =========================================================================
       SEÇÃO 4: RADAR DA SEMANA PARA OS PAIS (ACOMPANHAMENTO ACOLHEDOR)
       ========================================================================= -->
  <section class="py-16 lg:py-24 bg-slate-950 border-b-2 border-brand-gold/20 relative">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Card Majestoso do Radar da Semana -->
      <div class="relative bg-gradient-to-b from-brand-red/30 via-slate-900 to-brand-blue/30 rounded-3xl p-1 border-2 border-brand-gold shadow-2xl">
        <div class="bg-slate-950/95 rounded-[22px] p-6 sm:p-10 space-y-8">
          
          <!-- Cabeçalho do Radar -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-800">
            <div>
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-gold/10 border border-brand-gold/40 text-amber-300 text-xs font-bold uppercase tracking-wider font-sans mb-2">
                <span class="w-2 h-2 rounded-full bg-brand-gold animate-ping"></span>
                <span>Radar da Semana • Aula Prática Ativa</span>
              </div>
              <h2 class="text-2xl sm:text-3xl font-black font-display text-white">
                Aula 02: O Crachá dos Arquivos & Extensões Ocultas no Windows
              </h2>
            </div>
            
            <span class="px-4 py-1.5 rounded-xl bg-slate-900 border border-brand-gold/50 text-brand-gold font-mono text-xs font-bold self-start sm:self-auto">
              Semana 02 de 12
            </span>
          </div>

          <!-- Resumo Pedagógico Acessível -->
          <div class="space-y-3 font-sans">
            <h4 class="text-sm font-bold uppercase tracking-wider text-amber-300 flex items-center gap-2">
              <i class="fa-solid fa-circle-info text-brand-gold"></i> O que os 5 estudantes viveram na prática:
            </h4>
            <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
              No último sábado, os alunos descobriram que o Windows costuma esconder o final dos nomes dos arquivos por padrão. Eles aprenderam a ativar a exibição de extensões ocultas e realizaram a análise prática de arquivos de texto (<code class="text-brand-gold">.txt</code>), dados estruturados (<code class="text-brand-gold">.json</code>), imagens (<code class="text-brand-gold">.png</code>) e o perigo real dos executáveis (<code class="text-brand-red">.exe / .bat</code>).
            </p>
          </div>

          <!-- Dica de Ouro para o Almoço em Família -->
          <div class="p-6 rounded-2xl bg-gradient-to-r from-amber-500/10 via-slate-900 to-amber-500/10 border-2 border-brand-gold/60 space-y-3 shadow-lg">
            <div class="flex items-center gap-2.5 text-brand-gold font-display font-bold text-base sm:text-lg">
              <i class="fa-solid fa-utensils text-xl"></i>
              <span>Dica de Ouro para a Conversa em Família</span>
            </div>
            
            <p class="text-white text-base sm:text-lg font-semibold italic font-sans leading-relaxed">
              "Pergunte ao seu filho como ele descobre se um arquivo <span class="text-sky-300">.png</span> é na verdade um vírus <span class="text-red-400">.exe</span> disfarçado!"
            </p>
            
            <p class="text-xs sm:text-sm text-slate-300 font-sans">
              Ao pedir para a criança explicar a pegadinha da extensão dupla (ex: <code class="text-brand-gold">foto_do_jogo.png.exe</code>), você estimula o raciocínio dela e reforça a autoproteção no computador de casa.
            </p>
          </div>

          <!-- Botões de Ação para os Pais -->
          <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-4 border-t border-slate-800 font-sans">
            <a 
              href="/pais" 
              class="w-full sm:w-auto px-6 py-3 rounded-xl font-bold bg-gradient-to-r from-brand-gold to-amber-500 text-slate-950 hover:brightness-110 transition shadow-lg flex items-center justify-center gap-2 text-sm"
            >
              <i class="fa-solid fa-user-shield"></i>
              <span>Ver Todas as Dicas na Área dos Pais</span>
            </a>

            <a 
              href="/trilha" 
              class="text-xs sm:text-sm font-semibold text-slate-400 hover:text-brand-gold transition flex items-center gap-1.5"
            >
              <span>Ver Trilha Completa de 12 Semanas</span>
              <i class="fa-solid fa-arrow-right text-xs"></i>
            </a>
          </div>

        </div>
      </div>

    </div>
  </section>

</main>

<%- include('partials/footer') %>
