<%- include('partials/header', { 
  titulo: 'Projeto LiraCode • Aprenda a controlar o computador, não apenas usá-lo',
  paginaAtiva: 'inicio'
}) %>

<main class="flex-grow">
  
  <!-- HERO SECTION: O Propósito Nobre do Projeto -->
  <section class="relative overflow-hidden py-12 lg:py-20 bg-gradient-to-b from-slate-950 via-brand-darkblue to-slate-900 border-b border-brand-gold/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        
        <!-- Coluna de Apresentação e Boas-Vindas -->
        <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
          
          <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-brand-red/30 border border-brand-gold/60 text-amber-300 text-xs sm:text-sm font-bold tracking-wide shadow-sm">
            <i class="fa-solid fa-microchip text-brand-gold"></i>
            <span><%= curso.mentor %></span>
          </div>
          
          <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black font-display tracking-tight text-white leading-tight">
            Aprenda a controlar o computador, <br class="hidden sm:inline">
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-gold via-yellow-200 to-amber-400">
              não apenas usá-lo.
            </span>
          </h1>

          <p class="text-slate-300 text-base sm:text-lg leading-relaxed max-w-2xl mx-auto lg:mx-0">
            Um projeto acolhedor dedicado aos meus filhos e seus amigos (faixa etária de 10 a 16 anos). Ensinando os fundamentos que não ensinam na escola tradicional: anatomia do sistema operacional, estrutura de arquivos, cibersegurança real e raciocínio lógico estruturado!
          </p>

          <!-- Badges de Metadados -->
          <div class="flex flex-wrap items-center justify-center lg:justify-start gap-3 pt-1">
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-slate-900/90 border border-slate-700 text-xs text-slate-300">
              <i class="fa-solid fa-users text-brand-gold"></i>
              <span><strong>Público:</strong> <%= curso.faixaEtaria %></span>
            </div>
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-slate-900/90 border border-slate-700 text-xs text-slate-300">
              <i class="fa-solid fa-calendar-days text-amber-300"></i>
              <span><strong>Encontros:</strong> <%= curso.formato %></span>
            </div>
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-slate-900/90 border border-slate-700 text-xs text-slate-300">
              <i class="fa-solid fa-shield-halved text-emerald-400"></i>
              <span><strong>Status:</strong> <%= curso.statusTurma %></span>
            </div>
          </div>

          <!-- Pilares da Turma de Alunos -->
          <div class="pt-4 border-t border-slate-800/80 flex flex-wrap items-center justify-center lg:justify-start gap-3 text-xs text-slate-300">
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-slate-900/90 border border-brand-gold/40 text-amber-300 font-semibold shadow-sm">
              <i class="fa-solid fa-graduation-cap text-brand-gold"></i>
              <span>Portfólio Individual para Cada Aluno</span>
            </div>
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-slate-900/90 border border-blue-500/40 text-sky-300 font-semibold shadow-sm">
              <i class="fa-solid fa-code text-sky-400"></i>
              <span>Projetos Práticos & Autorais</span>
            </div>
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-slate-900/90 border border-emerald-500/40 text-emerald-300 font-semibold shadow-sm">
              <i class="fa-solid fa-shield-check text-emerald-400"></i>
              <span>Segurança Ativa na Internet</span>
            </div>
          </div>

        </div>

        <!-- Coluna Visual / Cartão Tático de Boas-Vindas -->
        <div class="lg:col-span-5 flex justify-center">
          <div class="relative w-full max-w-md bg-gradient-to-b from-brand-red via-red-950 to-brand-blue rounded-3xl p-1 border-2 border-brand-gold shadow-2xl badge-glow">
            <div class="bg-slate-950/95 rounded-[22px] p-6 sm:p-7 space-y-5">
              
              <!-- Cabeçalho do Card -->
              <div class="flex items-center justify-between pb-3 border-b border-slate-800">
                <div class="flex items-center gap-2.5">
                  <span class="w-3.5 h-3.5 rounded-full bg-brand-red shadow"></span>
                  <span class="w-3.5 h-3.5 rounded-full bg-brand-gold shadow"></span>
                  <span class="w-3.5 h-3.5 rounded-full bg-brand-blue shadow"></span>
                </div>
                <span class="text-xs font-mono text-amber-300 bg-amber-950/70 px-2.5 py-0.5 rounded border border-brand-gold/40">
                  ERA 486 ➔ 2026
                </span>
              </div>

              <!-- Missão -->
              <div class="space-y-2">
                <div class="text-xs font-bold uppercase tracking-wider text-brand-gold flex items-center gap-2">
                  <i class="fa-solid fa-crosshairs"></i> O Propósito Central
                </div>
                <p class="text-xs sm:text-sm text-slate-300 bg-slate-900/90 p-4 rounded-xl border border-slate-800 leading-relaxed">
                  Não é sobre apenas apertar botões ou decorar telas. É sobre <strong>entender o que o sistema operacional faz por trás dos panos</strong>, como arquivos funcionam e como nos blindamos na internet.
                </p>
              </div>

              <!-- Destaque da Semana Ativa -->
              <div class="p-4 rounded-2xl bg-gradient-to-r from-brand-red/30 via-slate-900 to-amber-950/40 border border-brand-gold/50 space-y-2">
                <div class="flex items-center justify-between">
                  <span class="text-[11px] font-bold uppercase tracking-wider text-brand-gold flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-brand-gold animate-ping"></span>
                    Aula da Semana: Semana 02
                  </span>
                  <span class="text-xs text-amber-300 font-mono">Sábado</span>
                </div>
                <h3 class="text-sm font-bold text-white font-display">
                  O Crachá dos Arquivos: .txt, .json, .png, .exe
                </h3>
                <p class="text-xs text-slate-300">
                  Desmascarando extensões ocultas no Windows e a pegadinha de malwares como <code class="text-brand-gold">foto.png.exe</code>.
                </p>
                <div class="pt-2">
                  <a href="/trilha?semana=2" class="inline-flex items-center gap-2 text-xs font-bold text-brand-gold hover:text-yellow-200 transition">
                    <span>Ver detalhes da aula prática</span>
                    <i class="fa-solid fa-arrow-right text-[10px]"></i>
                  </a>
                </div>
              </div>

            </div>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- SEÇÃO: OS 3 PORTAIS DE ENTRADA DO ECOSSISTEMA -->
  <section class="py-16 bg-slate-900/90 border-b border-brand-gold/20 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-12 space-y-3">
        <span class="text-xs uppercase font-extrabold tracking-widest text-brand-gold bg-brand-gold/10 px-3.5 py-1.5 rounded-full border border-brand-gold/30 inline-block">
          NAVEGAÇÃO RÁPIDA & OBJETIVA
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold font-display text-white">
          Os 3 Portais do Ecossistema LiraCode
        </h2>
        <p class="text-slate-300 text-sm sm:text-base">
          Escolha seu destino para acompanhar o aprendizado, explorar os conteúdos semanais ou testar os códigos construídos.
        </p>
      </div>

      <!-- Grid dos 3 Cards de Entrada -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        <!-- PORTAL 1: Trilha de Estudos -->
        <div class="portal-card p-7 flex flex-col justify-between group">
          <div class="space-y-5">
            <div class="w-14 h-14 rounded-2xl bg-brand-red/20 border border-brand-red text-red-400 flex items-center justify-center text-2xl group-hover:scale-110 transition-transform shadow-lg">
              <i class="fa-solid fa-route"></i>
            </div>
            
            <div>
              <div class="text-xs font-bold uppercase tracking-wider text-brand-gold mb-1">
                Cronograma de 12 Aulas
              </div>
              <h3 class="text-2xl font-bold font-display text-white group-hover:text-brand-gold transition-colors">
                Trilha de Estudos
              </h3>
            </div>

            <p class="text-sm text-slate-300 leading-relaxed">
              Mural completo aula a aula. Confira o que já aprendemos, o foco da <strong>Aula 02 de Cibersegurança</strong> e baixe os arquivos de treino para praticar no computador.
            </p>

            <ul class="space-y-2 text-xs text-slate-400 border-t border-slate-800/80 pt-4">
              <li class="flex items-center gap-2">
                <i class="fa-solid fa-check text-emerald-400"></i>
                <span>Linha do tempo das 12 semanas</span>
              </li>
              <li class="flex items-center gap-2">
                <i class="fa-solid fa-check text-emerald-400"></i>
                <span>Downloads de arquivos .json, .txt, .bat</span>
              </li>
              <li class="flex items-center gap-2">
                <i class="fa-solid fa-check text-emerald-400"></i>
                <span>Simulador de extensões do Windows</span>
              </li>
            </ul>
          </div>

          <div class="pt-6">
            <a href="/trilha" class="w-full py-3.5 px-4 rounded-xl font-bold bg-gradient-to-r from-brand-red to-brand-darkred hover:brightness-110 text-white flex items-center justify-center gap-2 border border-brand-gold/40 shadow-lg transition">
              <span>Acessar Trilha de Estudos</span>
              <i class="fa-solid fa-arrow-right"></i>
            </a>
          </div>
        </div>

        <!-- PORTAL 2: Área dos Pais & Família -->
        <div class="portal-card p-7 flex flex-col justify-between group border-brand-gold/50 shadow-xl">
          <div class="space-y-5">
            <div class="w-14 h-14 rounded-2xl bg-brand-gold/20 border border-brand-gold text-brand-gold flex items-center justify-center text-2xl group-hover:scale-110 transition-transform shadow-lg">
              <i class="fa-solid fa-user-shield"></i>
            </div>
            
            <div>
              <div class="text-xs font-bold uppercase tracking-wider text-amber-300 mb-1">
                Espaço Exclusivo da Família
              </div>
              <h3 class="text-2xl font-bold font-display text-white group-hover:text-amber-300 transition-colors">
                Área dos Pais
              </h3>
            </div>

            <p class="text-sm text-slate-300 leading-relaxed">
              Explicado em linguagem humana, sem termos difíceis. Veja o valor pedagógico do que seu filho está aprendendo e confira <strong>perguntas práticas para conversar no almoço de domingo</strong>.
            </p>

            <ul class="space-y-2 text-xs text-slate-400 border-t border-slate-800/80 pt-4">
              <li class="flex items-center gap-2">
                <i class="fa-solid fa-check text-amber-400"></i>
                <span>Resumo da semana sem jargão técnico</span>
              </li>
              <li class="flex items-center gap-2">
                <i class="fa-solid fa-check text-amber-400"></i>
                <span>Perguntas para o almoço em família</span>
              </li>
              <li class="flex items-center gap-2">
                <i class="fa-solid fa-check text-amber-400"></i>
                <span>Canal direto com o mentor no WhatsApp</span>
              </li>
            </ul>
          </div>

          <div class="pt-6">
            <a href="/pais" class="w-full py-3.5 px-4 rounded-xl font-bold bg-gradient-to-r from-brand-gold to-amber-500 hover:brightness-110 text-slate-950 flex items-center justify-center gap-2 shadow-lg shadow-amber-500/20 transition">
              <span>Acessar Portal da Família</span>
              <i class="fa-solid fa-arrow-right"></i>
            </a>
          </div>
        </div>

        <!-- PORTAL 3: Laboratório dos Alunos (Link Externo) -->
        <div class="portal-card p-7 flex flex-col justify-between group">
          <div class="space-y-5">
            <div class="w-14 h-14 rounded-2xl bg-brand-blue/30 border border-blue-500 text-sky-400 flex items-center justify-center text-2xl group-hover:scale-110 transition-transform shadow-lg">
              <i class="fa-solid fa-laptop-code"></i>
            </div>
            
            <div>
              <div class="text-xs font-bold uppercase tracking-wider text-sky-400 mb-1">
                Subdomínio de Prática & Portfólio
              </div>
              <h3 class="text-2xl font-bold font-display text-white group-hover:text-sky-300 transition-colors">
                Laboratório dos Alunos
              </h3>
            </div>

            <p class="text-sm text-slate-300 leading-relaxed">
              O ambiente prático onde os alunos sobem suas fichas pessoais, páginas web, experimentos em HTML/CSS e scripts. O verdadeiro palco de criações da turma!
            </p>

            <ul class="space-y-2 text-xs text-slate-400 border-t border-slate-800/80 pt-4">
              <li class="flex items-center gap-2">
                <i class="fa-solid fa-check text-sky-400"></i>
                <span>Acesso: <strong class="text-slate-200">aula.liracode.com.br</strong></span>
              </li>
              <li class="flex items-center gap-2">
                <i class="fa-solid fa-check text-sky-400"></i>
                <span>Fichas e projetos individuais</span>
              </li>
              <li class="flex items-center gap-2">
                <i class="fa-solid fa-check text-sky-400"></i>
                <span>Páginas publicadas pelos alunos</span>
              </li>
            </ul>
          </div>

          <div class="pt-6">
            <a href="https://aula.liracode.com.br/" target="_blank" rel="noopener noreferrer" class="w-full py-3.5 px-4 rounded-xl font-bold bg-gradient-to-r from-brand-blue to-blue-700 hover:brightness-110 text-white flex items-center justify-center gap-2 border border-blue-400/40 shadow-lg transition">
              <span>Entrar no Laboratório</span>
              <i class="fa-solid fa-arrow-up-right-from-square text-xs"></i>
            </a>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- SEÇÃO: MURAL DE MOMENTOS DA TURMA -->
  <section class="py-16 bg-slate-950 border-b border-brand-gold/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
        <div>
          <span class="text-xs uppercase font-extrabold tracking-widest text-brand-gold bg-brand-gold/10 px-3.5 py-1.5 rounded-full border border-brand-gold/30 inline-block mb-3">
            MEMÓRIAS & EVOLUÇÃO
          </span>
          <h2 class="text-3xl sm:text-4xl font-extrabold font-display text-white">
            Mural de Fotos & Momentos da Turma
          </h2>
          <p class="text-slate-300 text-sm sm:text-base mt-2 max-w-2xl">
            Registros visuais do aprendizado em sala, dos desafios superados no computador e do espírito de equipe de cada sábado.
          </p>
        </div>

        <div class="text-xs text-amber-300 font-mono flex items-center gap-2">
          <i class="fa-solid fa-camera text-brand-gold"></i>
          <span>Atualizado a cada encontro presencial</span>
        </div>
      </div>

      <!-- Grid de Cards do Mural -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <% momentos.forEach(function(item) { %>
          <div class="mural-card flex flex-col justify-between group">
            
            <!-- Topo do Card com Ilustração Tática / Gradiente Nobre -->
            <div class="h-44 bg-gradient-to-br <%= item.gradiente %> p-5 flex flex-col justify-between relative overflow-hidden">
              <div class="absolute -right-6 -bottom-6 w-24 h-24 bg-white/5 rounded-full blur-xl pointer-events-none"></div>

              <div class="flex items-center justify-between z-10">
                <span class="px-2.5 py-1 rounded-md bg-slate-950/80 border <%= item.corBorda %> text-[10px] font-bold uppercase tracking-wider text-amber-300 font-display">
                  <%= item.categoria %>
                </span>
                <span class="text-[11px] text-white/80 font-mono">
                  #0<%= item.id %>
                </span>
              </div>

              <!-- Ícone Central do Momento -->
              <div class="flex items-center gap-3 z-10">
                <div class="w-12 h-12 rounded-xl bg-slate-950/70 border border-brand-gold/40 flex items-center justify-center text-2xl text-brand-gold shadow group-hover:scale-110 transition-transform">
                  <i class="<%= item.icone %>"></i>
                </div>
                <div class="text-xs font-mono font-bold text-amber-200">
                  <%= item.detalhe %>
                </div>
              </div>
            </div>

            <!-- Corpo Textual do Card -->
            <div class="p-5 flex-grow flex flex-col justify-between space-y-3 bg-slate-900/90">
              <div>
                <span class="text-[11px] text-brand-gold font-semibold uppercase tracking-wider block">
                  <%= item.subtitulo %>
                </span>
                <h3 class="text-base font-bold font-display text-white mt-1 group-hover:text-amber-300 transition-colors">
                  <%= item.titulo %>
                </h3>
                <p class="text-xs text-slate-300 leading-relaxed mt-2">
                  <%= item.descricao %>
                </p>
              </div>

              <div class="pt-2 border-t border-slate-800 text-[11px] text-slate-400 flex items-center justify-between">
                <span>Presença Confirmada</span>
                <span class="text-emerald-400 font-semibold"><i class="fa-solid fa-check-double mr-1"></i> 100% Turma</span>
              </div>
            </div>

          </div>
        <% }); %>
      </div>

      <!-- Banner de Incentivo Familiar -->
      <div class="mt-12 p-6 rounded-3xl bg-gradient-to-r from-brand-blue/30 via-slate-900 to-brand-red/30 border-2 border-brand-gold/40 flex flex-col sm:flex-row items-center justify-between gap-6 shadow-xl">
        <div class="flex items-center gap-4 text-center sm:text-left">
          <div class="w-12 h-12 rounded-2xl bg-brand-gold text-slate-950 flex items-center justify-center text-2xl font-bold flex-shrink-0 shadow">
            <i class="fa-solid fa-shield-cat"></i>
          </div>
          <div>
            <h4 class="text-base font-bold text-white font-display">
              A cada sábado, uma nova conquista desbloqueada!
            </h4>
            <p class="text-xs sm:text-sm text-slate-300">
              Acompanhe a trilha para saber o que já está disponível e prepare seu filho para a aula de amanhã.
            </p>
          </div>
        </div>
        <div class="flex items-center gap-3">
          <a href="/trilha" class="px-5 py-2.5 rounded-xl bg-brand-gold text-slate-950 font-bold text-xs hover:brightness-110 transition whitespace-nowrap shadow">
            Ver Trilha Completa
          </a>
          <a href="/pais" class="px-5 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-600 font-bold text-xs transition whitespace-nowrap">
            Dicas para Pais
          </a>
        </div>
      </div>

    </div>
  </section>

</main>

<%- include('partials/footer') %>
