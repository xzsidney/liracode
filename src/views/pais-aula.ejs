<%- include('partials/header', { 
  titulo: 'Diário de Bordo • Aula ' + String(aula.numero).padStart(2, '0') + ' - ' + aula.titulo + ' • Portal dos Pais LiraCode',
  paginaAtiva: 'pais'
}) %>

<main class="flex-grow">
  
  <!-- CABEÇALHO DA AULA & NAVEGAÇÃO SUPERIOR -->
  <section class="py-10 bg-gradient-to-b from-slate-950 via-slate-900 to-brand-darkblue border-b border-brand-gold/30">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Barra Superior com Voltar e Breadcrumb -->
      <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
        <a href="/pais" class="inline-flex items-center gap-2.5 px-4 py-2 rounded-xl bg-slate-900/90 border border-brand-gold/40 text-amber-300 hover:text-white hover:bg-slate-800 transition text-sm font-semibold shadow-sm">
          <i class="fa-solid fa-arrow-left text-brand-gold"></i>
          <span>Voltar ao Painel dos Pais</span>
        </a>

        <div class="flex items-center gap-2 text-xs font-mono text-slate-400">
          <a href="/pais" class="hover:text-brand-gold transition">Área dos Pais</a>
          <span>/</span>
          <span class="text-brand-gold font-bold">Aula <%= String(aula.numero).padStart(2, '0') %></span>
        </div>
      </div>

      <!-- Banner Principal da Aula -->
      <div class="bg-slate-950/90 rounded-3xl p-6 sm:p-10 border-2 border-brand-gold/60 shadow-2xl relative overflow-hidden">
        <div class="absolute -right-16 -top-16 w-64 h-64 bg-brand-gold/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -left-16 -bottom-16 w-64 h-64 bg-brand-blue/20 rounded-full blur-3xl pointer-events-none"></div>

        <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6 pb-6 border-b border-slate-800/80">
          <div>
            <div class="flex flex-wrap items-center gap-3 mb-3">
              <!-- Badge de Identificação da Aula -->
              <span class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-brand-gold/20 border border-brand-gold/50 text-amber-300 text-xs font-bold uppercase tracking-wider">
                <i class="<%= aula.icone || 'fa-solid fa-book-bookmark' %> text-brand-gold"></i>
                <span>Encontro <%= String(aula.numero).padStart(2, '0') %> de <%= totalAulas %></span>
              </span>

              <!-- Badge de Status -->
              <% if (aula.status === 'concluida') { %>
                <span class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 text-xs font-bold uppercase">
                  <i class="fa-solid fa-circle-check"></i> Aula Concluída
                </span>
              <% } else if (aula.status === 'em-andamento') { %>
                <span class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full bg-amber-500/20 text-amber-300 border border-amber-500/40 text-xs font-bold uppercase animate-pulse">
                  <i class="fa-solid fa-bolt"></i> Aula da Semana • Em Andamento
                </span>
              <% } else { %>
                <span class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full bg-slate-800 text-slate-300 border border-slate-700 text-xs font-bold uppercase">
                  <i class="fa-solid fa-clock"></i> Próxima Aula
                </span>
              <% } %>
            </div>

            <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold font-display text-white tracking-wide">
              Aula <%= String(aula.numero).padStart(2, '0') %>: <%= aula.titulo %>
            </h1>
            <p class="text-slate-300 text-xs sm:text-sm mt-2 font-medium">
              Diário de Bordo Oficial • Relato autêntico do laboratório de tecnologia para as famílias
            </p>
          </div>

          <!-- Ação Rápida / Link do Laboratório do Aluno -->
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
            <% if (aula.linkLaboratorio) { %>
              <a href="<%= aula.linkLaboratorio %>" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-2xl bg-gradient-to-r from-sky-600 to-brand-blue hover:from-sky-500 hover:to-blue-700 text-white font-bold text-xs sm:text-sm shadow-lg transition transform active:scale-95 border border-sky-400/40">
                <i class="fa-solid fa-laptop-code"></i>
                <span>Ver Laboratório do Aluno</span>
                <i class="fa-solid fa-arrow-up-right-from-square text-[10px] opacity-75"></i>
              </a>
            <% } %>
            <a href="https://wa.me/5511999998888" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 px-4 py-3 rounded-2xl bg-emerald-600/90 hover:bg-emerald-500 text-white font-bold text-xs sm:text-sm transition shadow-md">
              <i class="fa-brands fa-whatsapp text-base"></i>
              <span>Dúvidas com Sidney</span>
            </a>
          </div>
        </div>

        <!-- Indicador dos 5 Estudantes Pioneiros -->
        <div class="pt-5 flex flex-wrap items-center justify-between gap-4 text-xs text-slate-400">
          <div class="flex items-center gap-2">
            <span class="text-amber-400 font-bold uppercase tracking-wider font-display">Turma Oficial:</span>
            <span>Enzo, Paulo Henrique, Jennifer, Ana Luiza & Isabely</span>
          </div>
          <div class="flex items-center gap-1.5 text-amber-300 font-semibold">
            <i class="fa-solid fa-shield-halved text-brand-gold"></i>
            <span>Ambiente com Privacidade & Proteção de Menores</span>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- CONTEÚDO PRINCIPAL: OS 4 CARDS NOBRES -->
  <section class="py-12 bg-slate-900/95 border-b border-brand-gold/20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      
      <!-- CARD 1: O QUE AS CRIANÇAS FIZERAM NO LABORATÓRIO -->
      <article class="bg-slate-950 rounded-3xl p-6 sm:p-9 border-2 border-brand-gold/40 shadow-xl relative overflow-hidden group hover:border-brand-gold/70 transition-all duration-300">
        <div class="flex items-start gap-4">
          <div class="w-12 h-12 rounded-2xl bg-brand-gold text-slate-950 flex items-center justify-center text-2xl font-black shrink-0 shadow-md">
            <i class="fa-solid fa-microchip"></i>
          </div>
          <div class="space-y-3 flex-grow">
            <div class="flex items-center justify-between gap-2">
              <span class="text-xs font-bold text-brand-gold uppercase tracking-wider font-display">
                Passo 1 • A Vivência Prática
              </span>
              <span class="text-[11px] text-slate-400 font-mono">Relato de Sala de Aula</span>
            </div>
            <h2 class="text-xl sm:text-2xl font-extrabold font-display text-white">
              O Que as Crianças Fizeram no Laboratório
            </h2>
            <div class="p-4 sm:p-5 rounded-2xl bg-slate-900/90 border border-slate-800 text-slate-200 text-sm sm:text-base leading-relaxed">
              <%= aula.oQueFizemos %>
            </div>
          </div>
        </div>
      </article>

      <!-- CARD 2: POR QUE ESSE PASSO É VITAL PARA O FUTURO DELES -->
      <article class="bg-slate-950 rounded-3xl p-6 sm:p-9 border-2 border-brand-gold/40 shadow-xl relative overflow-hidden group hover:border-brand-gold/70 transition-all duration-300">
        <div class="flex items-start gap-4">
          <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-brand-red to-brand-darkred text-white flex items-center justify-center text-2xl font-black shrink-0 shadow-md border border-brand-gold/30">
            <i class="fa-solid fa-compass"></i>
          </div>
          <div class="space-y-3 flex-grow">
            <div class="flex items-center justify-between gap-2">
              <span class="text-xs font-bold text-amber-300 uppercase tracking-wider font-display">
                Passo 2 • Fundamentação Pedagógica
              </span>
              <span class="text-[11px] text-slate-400 font-mono">Sem Jargões Técnicos</span>
            </div>
            <h2 class="text-xl sm:text-2xl font-extrabold font-display text-white">
              Por Que Esse Passo é Vital para o Futuro Deles?
            </h2>
            <div class="p-4 sm:p-5 rounded-2xl bg-gradient-to-r from-brand-blue/20 to-slate-900 border border-brand-blue/40 text-slate-200 text-sm sm:text-base leading-relaxed">
              <%= aula.porQueImporta %>
            </div>
          </div>
        </div>
      </article>

      <!-- CARD 3: DESAFIO PRÁTICO DA SEMANA EM CASA -->
      <article class="bg-slate-950 rounded-3xl p-6 sm:p-9 border-2 border-brand-gold/40 shadow-xl relative overflow-hidden group hover:border-brand-gold/70 transition-all duration-300">
        <div class="flex items-start gap-4">
          <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-brand-blue to-indigo-950 text-white flex items-center justify-center text-2xl font-black shrink-0 shadow-md border border-brand-gold/40">
            <i class="fa-solid fa-house-laptop"></i>
          </div>
          <div class="space-y-3 flex-grow">
            <div class="flex items-center justify-between gap-2">
              <span class="text-xs font-bold text-sky-300 uppercase tracking-wider font-display">
                Passo 3 • Missão Prática em Casa
              </span>
              <span class="text-[11px] text-slate-400 font-mono">Autonomia Digital</span>
            </div>
            <h2 class="text-xl sm:text-2xl font-extrabold font-display text-white">
              Desafio Prático da Semana em Casa
            </h2>
            <div class="p-4 sm:p-5 rounded-2xl bg-slate-900/90 border border-slate-800 text-slate-200 text-sm sm:text-base leading-relaxed flex items-start gap-3">
              <i class="fa-solid fa-circle-check text-emerald-400 text-lg mt-0.5 shrink-0"></i>
              <div>
                <strong>A Missão do Estudante:</strong> <%= aula.desafioCasa %>
                <p class="text-xs text-slate-400 mt-2">
                  Incentive seu filho(a) a sentar ao computador e mostrar com calma como ele faz. Esse momento ensina paciência e comunicação!
                </p>
              </div>
            </div>
          </div>
        </div>
      </article>

      <!-- CARD 4: MOMENTO FAMÍLIA - PERGUNTAS PARA O ALMOÇO DE DOMINGO -->
      <article class="bg-slate-950 rounded-3xl p-6 sm:p-9 border-2 border-brand-gold shadow-2xl relative overflow-hidden">
        <div class="absolute -right-20 -bottom-20 w-56 h-56 bg-brand-gold/15 rounded-full blur-3xl pointer-events-none"></div>

        <div class="flex items-start gap-4 mb-6">
          <div class="w-12 h-12 rounded-2xl bg-brand-gold text-slate-950 flex items-center justify-center text-2xl font-black shrink-0 shadow-md">
            <i class="fa-solid fa-comments"></i>
          </div>
          <div>
            <span class="text-xs font-bold text-brand-gold uppercase tracking-wider font-display">
              Passo 4 • Conexão Familiar
            </span>
            <h2 class="text-xl sm:text-2xl font-extrabold font-display text-white">
              Momento Família: Perguntas para o Almoço de Domingo 🍝
            </h2>
            <p class="text-xs sm:text-sm text-slate-300 mt-1">
              Faça essas perguntas descontraídas à mesa. Observe o brilho nos olhos deles ao explicarem o que aprenderam:
            </p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <% aula.perguntasAlmoco.forEach(function(pergunta, idx) { %>
            <div class="bg-slate-900/90 rounded-2xl p-5 border-2 border-slate-800 hover:border-brand-gold/60 transition-all duration-300 space-y-3">
              <div class="flex items-center justify-between">
                <span class="w-8 h-8 rounded-lg bg-brand-gold/20 text-brand-gold flex items-center justify-center font-display font-black text-sm border border-brand-gold/40">
                  0<%= idx + 1 %>
                </span>
                <span class="text-[11px] uppercase tracking-wider text-amber-400 font-bold">
                  Pergunta de Ouro
                </span>
              </div>
              <h3 class="text-sm sm:text-base font-bold text-white leading-snug">
                "<%= pergunta %>"
              </h3>
              <div class="pt-2 text-xs text-slate-400 border-t border-slate-800 flex items-center gap-2">
                <i class="fa-solid fa-lightbulb text-amber-300"></i>
                <span>Estimula o jovem a pensar estruturado e expressar raciocínio</span>
              </div>
            </div>
          <% }); %>
        </div>
      </article>

      <!-- BARRA DE NAVEGAÇÃO NO RODAPÉ: ANTERIOR / PAINEL / PRÓXIMA -->
      <nav aria-label="Navegação entre aulas" class="bg-slate-950 rounded-2xl p-5 border-2 border-brand-gold/30 flex flex-wrap items-center justify-between gap-4 mt-10">
        <!-- Aula Anterior -->
        <div>
          <% if (semanaNumero > 1) { %>
            <a href="/pais/aula/<%= semanaNumero - 1 %>" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-slate-900 border border-slate-700 hover:border-brand-gold text-slate-200 hover:text-brand-gold transition text-xs sm:text-sm font-bold">
              <i class="fa-solid fa-chevron-left"></i>
              <span>Aula <%= String(semanaNumero - 1).padStart(2, '0') %> (Anterior)</span>
            </a>
          <% } else { %>
            <span class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-slate-900/40 text-slate-600 text-xs sm:text-sm font-medium cursor-not-allowed">
              <i class="fa-solid fa-chevron-left"></i>
              <span>Início do Histórico</span>
            </span>
          <% } %>
        </div>

        <!-- Botão Central Painel dos Pais -->
        <div>
          <a href="/pais" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-brand-gold text-slate-950 font-bold hover:bg-yellow-400 transition text-xs sm:text-sm shadow-md">
            <i class="fa-solid fa-table-cells-large"></i>
            <span>Todos os Diários de Bordo</span>
          </a>
        </div>

        <!-- Próxima Aula -->
        <div>
          <% if (semanaNumero < totalAulas) { %>
            <a href="/pais/aula/<%= semanaNumero + 1 %>" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-slate-900 border border-slate-700 hover:border-brand-gold text-slate-200 hover:text-brand-gold transition text-xs sm:text-sm font-bold">
              <span>Aula <%= String(semanaNumero + 1).padStart(2, '0') %> (Próxima)</span>
              <i class="fa-solid fa-chevron-right"></i>
            </a>
          <% } else { %>
            <span class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-slate-900/40 text-slate-600 text-xs sm:text-sm font-medium cursor-not-allowed">
              <span>Última Aula Cadastrada</span>
              <i class="fa-solid fa-chevron-right"></i>
            </span>
          <% } %>
        </div>
      </nav>

    </div>
  </section>

</main>

<%- include('partials/footer') %>
