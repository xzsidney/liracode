<%- include('partials/header', { 
  titulo: 'Área da Família • Projeto LiraCode',
  paginaAtiva: 'pais'
}) %>

<main class="flex-grow">
  
  <!-- CABEÇALHO DO PORTAL DA FAMÍLIA -->
  <section class="py-12 bg-gradient-to-b from-slate-950 via-slate-900 to-brand-darkblue border-b border-brand-gold/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div>
          <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-brand-gold/20 border border-brand-gold/50 text-amber-300 text-xs font-bold uppercase tracking-wider mb-3">
            <i class="fa-solid fa-heart-pulse text-brand-gold"></i>
            <span>Parceria Escola & Família</span>
          </div>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold font-display text-white">
            Portal dos Pais & Espaço da Família
          </h1>
          <p class="text-slate-300 text-sm sm:text-base mt-2 max-w-3xl leading-relaxed">
            Aqui você encontra resumos sem termos técnicos complicados, descobre o valor real de cada aula e recebe ideias de perguntas para conversar no almoço de domingo.
          </p>
        </div>

        <!-- Botão WhatsApp Direto com a Coordenação -->
        <div>
          <a href="https://wa.me/5511999998888" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-3 px-5 py-3.5 rounded-2xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm shadow-xl transition transform active:scale-95 whitespace-nowrap">
            <i class="fa-brands fa-whatsapp text-xl"></i>
            <span>Falar com o Mentor</span>
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- SEÇÃO 1: DIÁRIO DE BORDO DAS AULAS (ACOMPANHAMENTO ENCONTRO A ENCONTRO) -->
  <section class="py-14 bg-slate-900 border-b border-brand-gold/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-12 space-y-3">
        <span class="text-xs uppercase font-extrabold tracking-widest text-brand-gold bg-brand-gold/10 px-3.5 py-1.5 rounded-full border border-brand-gold/30 inline-block font-display">
          HISTÓRICO OFICIAL
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold font-display text-white">
          Diário de Bordo das Aulas
        </h2>
        <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
          Acompanhe o que os alunos vivenciaram na prática em cada sábado, a justificativa pedagógica sem jargão e as perguntas para o almoço em família:
        </p>
      </div>

      <!-- Grid com os Cards das Aulas 01, 02 e 03 -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
        <% if (typeof historicoAulas !== 'undefined' && historicoAulas.length > 0) { %>
          <% historicoAulas.forEach(function(aula) { %>
            <div class="bg-slate-950 rounded-3xl p-6 sm:p-7 border-2 <%= aula.status === 'em-andamento' ? 'border-brand-gold shadow-2xl relative shadow-amber-500/10' : 'border-slate-800 hover:border-brand-gold/50' %> flex flex-col justify-between transition-all duration-300 group">
              
              <div class="space-y-4">
                <!-- Topo do Card -->
                <div class="flex items-center justify-between gap-2 pb-3 border-b border-slate-800/80">
                  <span class="w-10 h-10 rounded-xl bg-brand-gold/20 text-brand-gold flex items-center justify-center font-display font-black text-sm border border-brand-gold/40">
                    <i class="<%= aula.icone || 'fa-solid fa-code' %>"></i>
                  </span>

                  <% if (aula.status === 'concluida') { %>
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/15 text-emerald-300 border border-emerald-500/30 text-[11px] font-bold uppercase tracking-wider">
                      <i class="fa-solid fa-circle-check"></i> Concluída
                    </span>
                  <% } else if (aula.status === 'em-andamento') { %>
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-500/20 text-amber-300 border border-amber-500/40 text-[11px] font-bold uppercase tracking-wider animate-pulse">
                      <i class="fa-solid fa-bolt"></i> Aula da Semana
                    </span>
                  <% } else { %>
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-slate-800 text-slate-400 border border-slate-700 text-[11px] font-bold uppercase tracking-wider">
                      <i class="fa-solid fa-clock"></i> Em Breve
                    </span>
                  <% } %>
                </div>

                <!-- Título e Número -->
                <div>
                  <span class="text-xs text-brand-gold font-bold uppercase tracking-wider block font-mono">
                    Semana <%= String(aula.numero).padStart(2, '0') %>
                  </span>
                  <h3 class="text-lg sm:text-xl font-extrabold font-display text-white mt-1 group-hover:text-brand-gold transition-colors leading-snug">
                    Aula <%= String(aula.numero).padStart(2, '0') %>: <%= aula.titulo %>
                  </h3>
                </div>

                <!-- O Que Fizemos (Trecho) -->
                <div class="bg-slate-900/80 p-4 rounded-2xl border border-slate-800/80 text-xs text-slate-300 space-y-2">
                  <span class="font-bold text-amber-300 block flex items-center gap-1.5">
                    <i class="fa-solid fa-laptop-code text-brand-gold"></i> O Que Fizemos no Laboratório:
                  </span>
                  <p class="leading-relaxed line-clamp-4">
                    <%= aula.oQueFizemos %>
                  </p>
                </div>

                <!-- Por Que Importa (Trecho) -->
                <div class="text-xs text-slate-400 leading-relaxed italic line-clamp-3">
                  <strong class="text-slate-300 not-italic">Por que importa:</strong> <%= aula.porQueImporta %>
                </div>
              </div>

              <!-- Ação do Card: Ver Diário da Aula -->
              <div class="pt-5 mt-4 border-t border-slate-800/80 flex items-center justify-between gap-3">
                <a href="/pais/aula/<%= aula.numero %>" class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl <%= aula.status === 'em-andamento' ? 'bg-brand-gold text-slate-950 font-bold hover:bg-yellow-400 shadow-lg shadow-amber-500/20' : 'bg-slate-900 hover:bg-slate-800 text-amber-300 hover:text-white border border-brand-gold/40' %> transition text-xs sm:text-sm font-bold">
                  <span>Ver Diário da Aula</span>
                  <i class="fa-solid fa-arrow-right text-xs"></i>
                </a>
              </div>

            </div>
          <% }); %>
        <% } %>
      </div>

    </div>
  </section>

  <!-- SEÇÃO 2: DESTAQUE PEDAGÓGICO DA SEMANA ATUAL -->
  <section class="py-12 bg-slate-950 border-b border-brand-gold/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="bg-slate-900/90 rounded-3xl p-6 sm:p-10 border-2 border-brand-gold shadow-2xl relative overflow-hidden space-y-6">
        <div class="absolute -right-16 -top-16 w-56 h-56 bg-brand-gold/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="flex flex-wrap items-center justify-between gap-4 pb-4 border-b border-slate-800">
          <div class="flex items-center gap-3">
            <span class="w-12 h-12 rounded-2xl bg-brand-gold text-slate-950 flex items-center justify-center text-2xl font-bold shadow">
              <i class="fa-solid fa-graduation-cap"></i>
            </span>
            <div>
              <span class="text-xs text-brand-gold font-bold uppercase tracking-wider block">
                O Que Estamos Ensinando Agora
              </span>
              <h2 class="text-xl sm:text-2xl font-extrabold font-display text-white">
                Aula <%= String(semanaAtual.numero).padStart(2, '0') %>: <%= semanaAtual.titulo %>
              </h2>
            </div>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-xs text-amber-300 font-mono bg-slate-950 px-3 py-1.5 rounded-xl border border-slate-700">
              Aulas Práticas aos Sábados
            </span>
            <a href="/pais/aula/<%= semanaAtual.numero %>" class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-brand-gold/20 hover:bg-brand-gold/30 text-amber-300 border border-brand-gold/50 text-xs font-bold transition">
              <span>Abrir Diário Completo</span>
              <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i>
            </a>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
          <div class="md:col-span-8 space-y-4">
            <h3 class="text-base font-bold text-amber-300">
              O que isso significa na vida real do seu filho(a)?
            </h3>
            <p class="text-sm text-slate-300 leading-relaxed">
              <%= semanaAtual.resumo %>
            </p>
            <p class="text-sm text-slate-300 leading-relaxed">
              A sensação de ver algo que você mesmo escreveu no Bloco de Notas virar um site de verdade na internet é o momento que acende a paixão pela tecnologia. Nossos 5 alunos deixam de ser simples consumidores de sites e passam a ser os construtores conscientes da web!
            </p>
          </div>

          <div class="md:col-span-4 bg-slate-950 p-5 rounded-2xl border border-brand-gold/40 space-y-3">
            <div class="text-xs font-bold uppercase tracking-wider text-brand-gold flex items-center gap-2">
              <i class="fa-solid fa-lightbulb"></i> Dica de Ouro da Semana
            </div>
            <p class="text-xs text-slate-300 leading-relaxed">
              "<%= semanaAtual.dicaParaPais %>"
            </p>
            <div class="pt-2 text-[11px] text-emerald-400 font-semibold flex items-center gap-1.5">
              <i class="fa-solid fa-circle-check"></i> Sem necessidade de conhecimento prévio dos pais!
            </div>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- SEÇÃO 2: PERGUNTAS PARA CONVERSAR NO ALMOÇO DE DOMINGO -->
  <section class="py-16 bg-slate-950 border-b border-brand-gold/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-14 space-y-3">
        <span class="text-xs uppercase font-extrabold tracking-widest text-amber-300 bg-amber-500/10 px-3.5 py-1.5 rounded-full border border-amber-500/30 inline-block">
          CONEXÃO EM FAMÍLIA
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold font-display text-white">
          Perguntas para o Almoço de Domingo 🍝
        </h2>
        <p class="text-slate-300 text-sm sm:text-base">
          O maior combustível do aprendizado de um jovem é o interesse genuíno dos pais. Use essas perguntas leves e divertidas para puxar assunto à mesa:
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <% perguntasAlmoco.forEach(function(item, index) { %>
          <div class="bg-gradient-to-br from-slate-900 via-slate-950 to-brand-darkblue rounded-2xl p-6 sm:p-7 border-2 border-slate-800 hover:border-brand-gold/60 transition-all duration-300 space-y-4 group">
            
            <div class="flex items-center justify-between">
              <span class="w-10 h-10 rounded-xl bg-brand-gold/20 text-brand-gold flex items-center justify-center font-display font-black text-base border border-brand-gold/40">
                0<%= index + 1 %>
              </span>
              <span class="text-[11px] uppercase tracking-wider text-amber-400 font-bold">
                Para Fazer à Mesa
              </span>
            </div>

            <h3 class="text-base sm:text-lg font-bold text-white group-hover:text-brand-gold transition-colors leading-snug">
              "<%= item.pergunta %>"
            </h3>

            <div class="bg-slate-900/90 p-4 rounded-xl border border-slate-800 text-xs text-slate-300 space-y-1">
              <span class="font-bold text-amber-300 block">Por trás dessa pergunta:</span>
              <p class="leading-relaxed"><%= item.motivo %></p>
            </div>

          </div>
        <% }); %>
      </div>

    </div>
  </section>

  <!-- SEÇÃO 3: REDE DE FAMÍLIAS CONECTADAS & CARTA DO MENTOR -->
  <section class="py-16 bg-slate-900 border-b border-brand-gold/20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <!-- Cards das Famílias Conectadas -->
      <div>
        <div class="text-center max-w-2xl mx-auto mb-8 space-y-2">
          <span class="text-xs uppercase font-extrabold tracking-widest text-brand-gold bg-brand-gold/10 px-3.5 py-1.5 rounded-full border border-brand-gold/30 inline-block font-display">
            COMUNIDADE LIRACODE
          </span>
          <h3 class="text-2xl sm:text-3xl font-extrabold font-display text-white">
            Nossa Rede de Famílias Conectadas
          </h3>
          <p class="text-xs sm:text-sm text-slate-300">
            A união entre mentoria e pais é o maior alicerce para o crescimento seguro dos nossos jovens:
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          <% familias.forEach(function(fam) { %>
            <div class="bg-slate-950 p-5 rounded-2xl border-2 border-brand-gold/30 hover:border-brand-gold transition shadow-lg space-y-2 text-center">
              <div class="w-10 h-10 rounded-xl bg-brand-gold/20 text-brand-gold flex items-center justify-center text-lg mx-auto shadow">
                <i class="<%= fam.icone %>"></i>
              </div>
              <h4 class="font-display font-bold text-white text-base">
                <%= fam.responsavel %>
              </h4>
              <p class="text-xs text-amber-300 font-semibold">
                <%= fam.parentesco %>
              </p>
            </div>
          <% }); %>
        </div>
      </div>

      <!-- Carta Aberta do Mentor Sidney -->
      <div class="bg-gradient-to-br from-brand-blue/30 via-slate-950 to-brand-red/30 rounded-3xl p-8 sm:p-12 border-2 border-brand-gold/40 shadow-2xl space-y-8">
        
        <div class="flex items-center gap-4">
          <div class="w-14 h-14 rounded-2xl bg-brand-gold text-slate-950 flex items-center justify-center text-3xl font-black shadow-lg">
            <i class="fa-solid fa-heart-pulse"></i>
          </div>
          <div>
            <span class="text-xs font-bold text-brand-gold uppercase tracking-wider">Origem & Propósito</span>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-white font-display">
              Uma Palavra Especial de Sidney para as Famílias
            </h2>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 text-sm text-slate-300 leading-relaxed">
          
          <div class="space-y-4">
            <h3 class="text-base font-bold text-amber-300 flex items-center gap-2">
              <i class="fa-solid fa-user-gear"></i> Por que essa iniciativa começou?
            </h3>
            <p>
              Trabalho na área de tecnologia há décadas, desde a época dos computadores 486, telas pretas e comandos manuais no DOS. Vi a internet nascer e a tecnologia evoluir de perto.
            </p>
            <p>
              Hoje, os jovens nascem arrastando o dedo em telas touchscreen de celular — eles sabem consumir vídeos e jogos, mas raramente entendem o que acontece por trás do vidro.
            </p>
            <p>
              Reunir Enzo, Paulo Henrique, Jennifer, Ana Luiza e Isabely aos sábados é uma honra e uma forma de compartilhar essa bagagem, criando uma base lógica sólida que servirá para qualquer profissão futura: medicina, direito, engenharia, finanças ou tecnologia.
            </p>
          </div>

          <div class="space-y-4">
            <h3 class="text-base font-bold text-amber-300 flex items-center gap-2">
              <i class="fa-solid fa-shield-halved"></i> O que os jovens desenvolvem aqui:
            </h3>
            <ul class="space-y-3 text-xs sm:text-sm">
              <li class="flex items-start gap-2.5">
                <i class="fa-solid fa-check text-emerald-400 mt-1"></i>
                <span><strong>Segurança real na Internet:</strong> Aprendem a identificar armadilhas, golpes de jogos e arquivos maliciosos sem medo.</span>
              </li>
              <li class="flex items-start gap-2.5">
                <i class="fa-solid fa-check text-emerald-400 mt-1"></i>
                <span><strong>Paciência e Resolução de Problemas:</strong> Erros na programação são normais. Eles aprendem a investigar em vez de desistir.</span>
              </li>
              <li class="flex items-start gap-2.5">
                <i class="fa-solid fa-check text-emerald-400 mt-1"></i>
                <span><strong>Trabalho em Equipe e Respeito:</strong> Criam companheirismo e amizade compartilhando descobertas com a turma.</span>
              </li>
            </ul>
          </div>

        </div>

      </div>

    </div>
  </section>

  <!-- SEÇÃO 4: DICAS PEDAGÓGICAS PARA O DIA A DIA -->
  <section class="py-16 bg-slate-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-14 space-y-3">
        <span class="text-xs uppercase font-extrabold tracking-widest text-brand-gold bg-brand-gold/10 px-3.5 py-1.5 rounded-full border border-brand-gold/30 inline-block">
          GUIA PRÁTICO PARA PAIS
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold font-display text-white">
          Como Apoiar seu Filho na Programação
        </h2>
        <p class="text-slate-300 text-sm sm:text-base">
          Pequenas atitudes em casa que fazem o entusiasmo e o raciocínio do jovem dispararem:
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <% dicasFamilia.forEach(function(dica) { %>
          <div class="bg-slate-900/90 rounded-2xl p-6 border-2 border-slate-800 hover:border-brand-gold/50 transition flex flex-col justify-between space-y-4">
            <div class="space-y-3">
              <span class="text-3xl block"><%= dica.icone %></span>
              <h3 class="text-base font-bold text-white font-display">
                <%= dica.titulo %>
              </h3>
              <p class="text-xs text-slate-300 leading-relaxed">
                <%= dica.descricao %>
              </p>
            </div>
            <div class="pt-2 text-[11px] text-amber-300 font-semibold border-t border-slate-800">
              💡 Aplique na rotina familiar
            </div>
          </div>
        <% }); %>
      </div>

    </div>
  </section>

</main>

<%- include('partials/footer') %>
